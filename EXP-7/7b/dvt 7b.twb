        <column datatype="real" name="[Total Goals]" role="measure" type="quantitative">
          <calculation class="tableau" formula="SUM([goals])" />
        </column>
        <column datatype="real" name="[Average Rating]" role="measure" type="quantitative">
          <calculation class="tableau" formula="AVG([player_rating])" />
        </column>
        <column datatype="real" name="[Minimum Score Filter]" role="dimension" type="ordinal">
          <calculation class="tableau" formula="[performance_score] &gt;= 70" />
        </column>
      </datasource>
    </object-id>
  </datasources>
  <worksheets>
    <worksheet name="Team Goals Bar Chart">
      <table>
        <view>
          <datasources><datasource caption="FIFA World Cup 2026 Player Performance" name="fifa" /></datasources>
          <datasource-dependencies datasource="fifa">
            <column datatype="string" name="[team]" role="dimension" type="nominal" />
            <column datatype="real" name="[goals]" role="measure" type="quantitative" />
          </datasource-dependencies>
          <manual-sort />
        </view>
        <style><style-rule element="mark"><format attr="mark-labels-show" value="true" /></style-rule></style>
      </table>
    </worksheet>
    <worksheet name="Distribution Pie Chart">
      <table>
        <view>
          <datasources><datasource caption="FIFA World Cup 2026 Player Performance" name="fifa" /></datasources>
          <datasource-dependencies datasource="fifa">
            <column datatype="string" name="[match_result]" role="dimension" type="nominal" />
          </datasource-dependencies>
        </view>
      </table>
    </worksheet>
    <worksheet name="Performance Trend Line Chart">
      <table>
        <view>
          <datasources><datasource caption="FIFA World Cup 2026 Player Performance" name="fifa" /></datasources>
          <datasource-dependencies datasource="fifa">
            <column datatype="string" name="[player_name]" role="dimension" type="nominal" />
            <column datatype="real" name="[goals]" role="measure" type="quantitative" />
          </datasource-dependencies>
        </view>
      </table>
    </worksheet>
    <worksheet name="Minimum Score Analysis">
      <table>
        <view>
          <datasources><datasource caption="FIFA World Cup 2026 Player Performance" name="fifa" /></datasources>
          <datasource-dependencies datasource="fifa">
            <column datatype="string" name="[team]" role="dimension" type="nominal" />
            <column datatype="real" name="[performance_score]" role="measure" type="quantitative" />
          </datasource-dependencies>
        </view>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard enable-sort-zone-taborder="true" name="EXP7B FIFA Performance Dashboard">
      <layout-options>
        <title>
          <formatted-text><run fontcolor="#000000">FIFA World Cup 2026 Player Performance Dashboard</run></formatted-text>
        </title>
      </layout-options>
      <zones>
        <zone name="Team Goals Bar Chart" />
        <zone name="Distribution Pie Chart" />
        <zone name="Performance Trend Line Chart" />
        <zone name="Minimum Score Analysis" />
      </zones>
    </dashboard>
  </dashboards>
  <stories>
    <story name="EXP7B FIFA Performance Story">
      <story-points>
        <story-point name="Team Goal Analysis" />
        <story-point name="Distribution Analysis" />
        <story-point name="Performance Trend" />
        <story-point name="Minimum Score Analysis" />
      </story-points>
    </story>
  </stories>
</workbook>
